# ============================================================================
# CreatorOps 环境变量模板
# 使用方式：cp .env.example .env 后按本地情况修改，切勿把真实密钥提交到仓库。
# 生产环境请使用密钥管理服务（Vault / KMS / 云厂商 Secret Manager）注入。
# ============================================================================

# ---------- 运行环境 ----------
NODE_ENV=development
API_PORT=3100
WEB_ORIGIN=http://localhost:5173
# 对外访问前缀，用于生成回调地址与 Swagger server
PUBLIC_BASE_URL=http://localhost:3100

# ---------- 数据库 ----------
DATABASE_URL=postgresql://creatorops:creatorops@localhost:5432/creatorops?schema=public
# 连接池上限：按 (CPU 核数 * 2 + 磁盘数) 经验值设置，PgBouncer 前置时设为实例数的 1/4
DATABASE_POOL_SIZE=10

# ---------- Redis（当前未使用，为后续预留） ----------
# 现状说明：本项目**没有任何代码读取 REDIS_URL**。
#   - 限流用 @nestjs/throttler 的内存计数（多实例下阈值 = 配置值 × 实例数）
#   - 后台任务用 @nestjs/schedule 的进程内调度
# 也就是说：本地不启 Redis 也能完整跑通，docker-compose 里的 redis 服务是
# 为「将来引入分布式限流 / BullMQ 队列 / 定时任务选主」预留的。
# 若引入，请同步在 package.json 加 ioredis，并把限流 storage 切到 Redis
# （见 docs/deployment.md「多实例与定时任务」）。
REDIS_URL=redis://localhost:6379/0

# ---------- 认证 ----------
# 生产必须替换：openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-in-production
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-in-production
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=14d
# 密码哈希成本，CI/测试可降到 4 以加速
BCRYPT_ROUNDS=12

# ---------- 限流 ----------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
LOGIN_THROTTLE_LIMIT=10

# ---------- 日志 ----------
# 当前实现使用 NestJS 内置 Logger（结构化字段：level/context/message，并带 requestId）。
# LOG_LEVEL / LOG_PRETTY 为接入 pino 预留：pino 支持 JSON 输出与 pretty 美化，
# 适合接 Loki/ELK。若要启用，需在依赖中加入 pino + nestjs-pino，并在 main.ts 里
# app.useLogger(app.get(Logger))。当前不引入是为了避免为一个内部工具增加重日志依赖。
LOG_LEVEL=debug
LOG_PRETTY=true
AUDIT_LOG_RETENTION_DAYS=365

# ---------- AI 能力层 ----------
# Provider 可选：openai | anthropic | gemini | deepseek | mock
# mock 为本地开发/CI 专用：不产生真实请求，返回确定性结果，保证离线可演示
AI_PROVIDER=mock
AI_DEFAULT_MODEL=gpt-4o-mini
AI_FALLBACK_PROVIDER=mock
AI_REQUEST_TIMEOUT_MS=45000
AI_MAX_RETRIES=2
# 单次调用 token 上限，用于成本熔断
AI_MAX_TOKENS_PER_CALL=4096
# 月度预算（元），超限后自动降级为 mock 并告警
AI_MONTHLY_BUDGET_CNY=2000
AI_COST_PER_1K_INPUT_TOKENS=0.0015
AI_COST_PER_1K_OUTPUT_TOKENS=0.006

OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# ---------- 对象存储（素材 / 报表导出） ----------
# 本地开发用 local 驱动落盘到 STORAGE_LOCAL_DIR
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=
S3_REGION=ap-east-1
S3_BUCKET=creatorops
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------- 第三方平台数据采集 ----------
# 未配置凭证时采集器进入 mock 模式，返回仿真数据便于联调
COLLECTOR_MODE=mock
DOUYIN_APP_ID=
DOUYIN_APP_SECRET=
XIAOHONGSHU_APP_ID=
XIAOHONGSHU_APP_SECRET=
BILIBILI_APP_ID=
BILIBILI_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
YOUTUBE_API_KEY=

# ---------- 结算 ----------
# 默认平台服务费率（%），合同可覆盖
SETTLEMENT_DEFAULT_PLATFORM_FEE_PERCENT=10
# 结算单自动生成日（每月几号）
SETTLEMENT_AUTO_GENERATE_DAY=3
# 账期天数
SETTLEMENT_PAYMENT_TERM_DAYS=30

# ---------- 告警 ----------
ALERT_WEBHOOK_URL=
ALERT_ON_AI_BUDGET_EXCEEDED=true
